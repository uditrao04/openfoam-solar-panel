FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1.0;

boundaryField
{

    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.075;
        value           $internalField;
    }

    outlet
    {
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }
    "(walls|constraint)"
    {
        type        symmetry;
        value       $internalField;
    }

    wall
    {
        type        omegaWallFunction;
        value       $internalField;
    }
    "(.*SP|bottom|wall|solarPanel)"
    {
        type        omegaWallFunction;
        value       $internalField;
    }

    defaultFaces
    {
        type        zeroGradient;
    }

}

