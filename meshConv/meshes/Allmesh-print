cd "${0%/*}" || exit 1
echo "======================================================================"
echo "  Starting Parallel Mesh Generation (Console Output Mode - Levels 1-10)"
echo "======================================================================"
for case_dir in  level0 level1 level2 level3 level4 level5 level6 level7 level8 level9; do
    if [ -d "$case_dir" ]; then
        echo ""
        echo ">>> Meshing Level $case_dir..."
        (
            cd "$case_dir" || exit 1
            if [ -f "./Allmesh-print" ]; then
                ./Allmesh-print
            fi
            rm -rf processor*
            rm -f 0/cellLevel 0/pointLevel
        )
        echo ">>> Level $case_dir meshing finished."
    fi
done
echo "======================================================================"
echo "  All 8 Mesh Convergence Levels Generated & Cleaned Successfully!"
echo "======================================================================"
